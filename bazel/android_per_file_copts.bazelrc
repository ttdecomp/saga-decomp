# Per-source optimization overrides for the matching target (Android x86).
#
# Include this fragment from the workspace .bazelrc with:
#   import %workspace%/bazel/android_per_file_copts.bazelrc
#
# Paths are anchored to the workspace-relative source path so these options
# apply only to the corresponding source.

build:target --per_file_copt=^src/batman\.cpp$@-O2
# The original rain unit was named .c but compiled as C++ (VuVec constructors).
build --per_file_copt=^src/nu2api/nu3d/android/nurain_android\.c$@-x,c++,-std=gnu++11
# The original Android time unit likewise used a .c filename with C++
# linkage for its clock helper functions.
build --per_file_copt=^src/nu2api/nucore/android/nutime_android\.c$@-x,c++,-std=gnu++11
# The original nuthread.c also uses C++ linkage and VuVec constructors.
build --per_file_copt=^src/nu2api/nucore/android/nuthread\.c$@-x,c++,-std=gnu++11
# Editor path callbacks in the original use optimized frameless PIC call sequences.
build:target --per_file_copt=^src/editor/edpath\.cpp$@-O2
# Recovered Android entry points; -O2 and -O3 emit the same measured bodies.
build:target --per_file_copt=^src/java/android\.cpp$@-O2
# Original OBB lookup uses optimized inlined strlen/strcat and omits leaf frames.
build:target --per_file_copt=^src/gamelib/util/AndroidOBBUtils\.cpp$@-O3
# The original cable bodies are optimized; UpdateCables also has the -O3
# vectorized stack-realignment pattern.
build:target --per_file_copt=^src/legoapi/items/objects/cable\.cpp$@-O3
# The allocator has no vectorizable code; -O2 and -O3 emit the same measured
# bodies, including nine exact constructors/destructor helpers.
build:target --per_file_copt=^src/gamelib/util/VirtualStackAllocator\.cpp$@-O2
# The original CRC constructor and hash loops are optimized; this is the
# measured TU setting, not a calling-convention override.
build:target --per_file_copt=^src/gamelib/util/CRC16\.cpp$@-O3
build:target --per_file_copt=^src/gamelib/util/Network_stubs\.cpp$@-O3
build:target --per_file_copt=^src/gamelib/util/Message\.cpp$@-O3
build:target --per_file_copt=^src/gamelib/util/Stats\.cpp$@-O3
# Recovered stub-only device units: -O3 reproduces FileSize exactly and the
# APK constructor/CreateNuFile and SetCurrentDir bodies apart from relocation.
build:target --per_file_copt=^src/nu2api/nufile/nufiledevice\.cpp$@-O3
build:target --per_file_copt=^src/nu2api/nufile/NuFileDeviceAndroidAPK\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/ai/aisys/aiscript\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/ai/aisys/aistate\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/ai/aisys/aisys\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/ai/aisys/gameai_actions\.cpp$@-O3
# Teleport parser callbacks in the target use optimized leaf/control-flow code.
build:target --per_file_copt=^src/gameapi/ai/gameai_tel\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/ai/gameai_bt\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/ai/gameai_grab\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/edtools/edfile\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/edtools/edsplines\.cpp$@-O3
build:target --per_file_copt=^src/gameapi/edtools/edtoolsall_stubs\.cpp$@-O2
build:target --per_file_copt=^src/gameframework/savesystem\.cpp$@-O3
# The click-to-start tracker is an optimized, frameless leaf in the original.
build:target --per_file_copt=^src/legoapi/core/input/input\.cpp$@-O2
