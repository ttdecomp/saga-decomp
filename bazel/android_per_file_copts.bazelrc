build:target --per_file_copt=^src/legoapi/actions/combat/rope\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/combat/shovesys\.cpp$@-O1
build:target --per_file_copt=^src/legoapi/actions/movement/pushblocks\.cpp$@-O1
build:target --per_file_copt=^src/legoapi/actions/movement/jumping\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/movement/climbing\.cpp$@-O2
