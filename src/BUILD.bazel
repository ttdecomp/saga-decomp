load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//bazel:saga_components.bzl", "saga_component_libraries")
load(
    "//scripts/checks:linters.bzl",
    "clang_tidy_android_check",
    "clang_tidy_check",
    "clang_tidy_wasm_check",
)

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "native_linux_debug",
    constraint_values = ["@platforms//os:linux"],
    define_values = {
        "SAGA_BUILD": "native",
        "SAGA_MODE": "debug",
    },
)

_ENGINE_DIRS = [
    "MechInputTouch",
    "editor",
    "gameapi",
    "gameframework",
    "gamelib",
    "legoapi",
    "legogame",
    "nu2api",
]

_ENGINE_ROOT_SRCS = [
    "batman.cpp",
    "globals.cpp",
    "java/android.cpp",
    "java/android_state.cpp",
]

_ENGINE_SRCS = _ENGINE_ROOT_SRCS + glob(
    [directory + "/**/*.c" for directory in _ENGINE_DIRS] +
    [directory + "/**/*.cpp" for directory in _ENGINE_DIRS],
    allow_empty = True,
)

_HOST_EXCLUDES = [
    "nu2api/nucore/android/nupostresource_create.cpp",
    "java/android.cpp",
    "nu2api/nu3d/android/NuGLES2Extensions.cpp",
    "nu2api/nucore/android/NuInputDevice_android.cpp",
    "nu2api/nucore/nunew.cpp",
]

_HOST_COMMON_SRCS = [source for source in _ENGINE_SRCS if source not in _HOST_EXCLUDES] + [
    "host/platform/postresource_create.cpp",
    "java/jni_stub.cpp",
    "host/harness/audio.cpp",
    "host/harness/load.cpp",
    "host/harness/main.cpp",
    "host/harness/save.cpp",
    "host/harness/window.cpp",
    "host/platform/compressed_texture.cpp",
    "host/platform/android_assets.cpp",
    "host/platform/documents.cpp",
    "host/platform/egl.cpp",
    "host/platform/gles_extensions.cpp",
    "host/platform/free_camera.cpp",
    "host/platform/free_camera_culling.cpp",
    "host/platform/input.cpp",
    "host/platform/opensl.cpp",
    "host/platform/runtime.cpp",
]

_NATIVE_PLATFORM_SRCS = ["host/platform/native_render_device.cpp"] + select({
    "//bazel/platforms:linux": [
        "host/platform/linux/render_device.cpp",
        "host/platform/linux/runtime.cpp",
        "host/platform/posix/compressed_texture.cpp",
        "host/platform/posix/egl.cpp",
    ],
    "//bazel/platforms:macos": [
        "host/platform/posix/compressed_texture.cpp",
        "host/platform/posix/egl.cpp",
    ],
    "//bazel/platforms:windows": [
        "host/platform/windows/posix_random.cpp",
        "host/platform/windows/runtime.cpp",
    ],
    "//conditions:default": [],
})

_WASM_PLATFORM_SRCS = [
    "host/platform/wasm/graphics.cpp",
    "host/platform/wasm/input.cpp",
    "host/platform/wasm/render_device.cpp",
    "host/platform/wasm/runtime.cpp",
]

_PUBLIC_HEADERS = glob(
    [
        "**/*.h",
        "**/*.hh",
        "**/*.hpp",
    ],
    allow_empty = True,
)

_TEXTUAL_HEADERS = [
    "legoapi/items/collect/bolttypes_lsw.inc",
    "legoapi/menus/core/lsw_text_data.inc",
    "nu2api/nu3d/android/nuios_shader_sources.inc",
    "nu2api/nu3d/nudlist_tables_gen.inc",
    "uberShader2.array",
]

filegroup(
    name = "all_source_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

_TARGET_COMPONENTS = saga_component_libraries(
    copts = [
        "-fno-data-sections",
        "-fno-function-sections",
    ],
    defines = ["ANDROID"],
    engine_dirs = _ENGINE_DIRS,
    headers = _PUBLIC_HEADERS,
    name_prefix = "saga_target",
    root_sources = _ENGINE_ROOT_SRCS,
    sources = _ENGINE_SRCS,
    target_compatible_with = ["@platforms//os:android"],
    textual_headers = _TEXTUAL_HEADERS,
    deps = [
        "@libogg//:ogg",
        "@libsquish//:squish",
        "@libvorbis//:vorbis",
        "@libvorbis//:vorbisfile",
    ],
)

cc_library(
    name = "saga_target_objects",
    target_compatible_with = ["@platforms//os:android"],
    deps = _TARGET_COMPONENTS,
)

clang_tidy_android_check(
    name = "clang_tidy_target",
    srcs = _TARGET_COMPONENTS,
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:android"],
)

cc_binary(
    name = "libTTapp.so",
    linkopts = [
        "-Wl,--no-undefined",
        "-llog",
        "-landroid",
        "-lOpenSLES",
        "-lEGL",
        "-lGLESv2",
        "-lstdc++",
    ],
    linkshared = True,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [":saga_target_objects"],
)

alias(
    name = "saga_target",
    actual = ":libTTapp.so",
)

_HOST_PLATFORM_COPTS = select({
    "//bazel/platforms:windows": ["-include", "src/host/platform/windows/posix_random.h"],
    "//bazel/platforms:linux": [
        "-m32",
        "-march=i686",
    ],
    "//conditions:default": [],
}) + select({
    ":native_linux_debug": ["-fsanitize=address,undefined"],
    "//conditions:default": [],
}) + select({
    "//bazel/platforms:x86_64": ["-msse2"],
    "//conditions:default": [],
})

_HOST_PLATFORM_DEPS = select({
    "//bazel/platforms:linux": ["@system_host_deps_linux//:host_deps"],
    "//bazel/platforms:macos": [
        ":saga_macos_platform",
        "@system_host_deps_macos//:host_deps",
    ],
    "//bazel/platforms:windows": ["@system_host_deps_windows//:host_deps"],
    "//conditions:default": [],
}) + ["@libsquish//:squish"]

objc_library(
    name = "saga_macos_platform",
    srcs = ["host/platform/darwin/runtime.mm"],
    hdrs = ["host/platform/runtime.hpp"],
    includes = ["."],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@system_host_deps_macos//:host_deps"],
    alwayslink = True,
)

_NATIVE_COMPONENTS = saga_component_libraries(
    copts = ["-fno-stack-protector"] + _HOST_PLATFORM_COPTS,
    defines = [
        "ANDROID",
        "HOST_BUILD",
    ],
    engine_dirs = _ENGINE_DIRS,
    headers = _PUBLIC_HEADERS,
    name_prefix = "saga_native",
    root_sources = [source for source in _ENGINE_ROOT_SRCS if source not in _HOST_EXCLUDES] + ["java/jni_stub.cpp"],
    sources = _HOST_COMMON_SRCS,
    textual_headers = _TEXTUAL_HEADERS,
    deps = _HOST_PLATFORM_DEPS,
)

cc_library(
    name = "saga_native_platform",
    srcs = _NATIVE_PLATFORM_SRCS,
    hdrs = _PUBLIC_HEADERS,
    copts = ["-fno-stack-protector"] + _HOST_PLATFORM_COPTS,
    defines = [
        "ANDROID",
        "HOST_BUILD",
    ],
    includes = ["."],
    linkstatic = True,
    linkopts = select({
        "//bazel/platforms:linux": ["-Wl,--wrap=MenuInMemoryCard"],
        "//conditions:default": [],
    }),
    local_defines = ["__FILENAME__=__FILE__"],
    textual_hdrs = _TEXTUAL_HEADERS,
    deps = _HOST_PLATFORM_DEPS,
    alwayslink = True,
)

cc_library(
    name = "saga_native_objects",
    deps = _NATIVE_COMPONENTS + [":saga_native_platform"],
)

clang_tidy_check(
    name = "clang_tidy_native",
    srcs = _NATIVE_COMPONENTS + [":saga_native_platform"],
    tags = ["manual"],
)

cc_binary(
    name = "saga_native",
    linkopts = select({
        "//bazel/platforms:linux": [
            "-m32",
            "-Wl,--wrap=NuFrameEnd",
        ],
        "//bazel/platforms:macos": [
            "-framework",
            "Cocoa",
            "-framework",
            "QuartzCore",
        ],
        "//bazel/platforms:windows": [
            "-Wl,--export-all-symbols",
        ],
        "//conditions:default": [],
    }) + select({
        ":native_linux_debug": ["-fsanitize=address,undefined"],
        "//conditions:default": [],
    }),
    linkstatic = False,
    deps = [":saga_native_objects"],
)

sh_binary(
    name = "run_native",
    srcs = ["host/harness/run_native.sh"],
    args = ["$(location :saga_native)"],
    data = [":saga_native"],
)

# Reuses the native engine archives; only the startup/test boundary differs.
cc_binary(
    name = "saga_smoke",
    srcs = ["host/harness/smoke.cpp"],
    copts = _HOST_PLATFORM_COPTS,
    defines = ["ANDROID", "HOST_BUILD"],
    local_defines = ["__FILENAME__=__FILE__"],
    linkopts = [
        "-m32",
        "-Wl,--wrap=main",
        "-Wl,--wrap=_Z7EndPermv",
        "-Wl,--wrap=_Z8LoadPermv",
        "-Wl,--wrap=NuFrameBegin",
        "-Wl,--wrap=NuFrameEnd",
    ] + select({
        ":native_linux_debug": ["-fsanitize=address,undefined"],
        "//conditions:default": [],
    }),
    linkstatic = False,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":saga_native_objects"],
)

sh_binary(
    name = "run_smoke",
    srcs = ["host/harness/run_native.sh"],
    args = ["$(location :saga_smoke)"],
    data = [":saga_smoke"],
)

cc_library(
    name = "saga_wasm_objects",
    srcs = _HOST_COMMON_SRCS + _WASM_PLATFORM_SRCS,
    hdrs = _PUBLIC_HEADERS,
    defines = [
        "ANDROID",
        "HOST_BUILD",
    ],
    includes = ["."],
    local_defines = ["__FILENAME__=__FILE__"],
    textual_hdrs = _TEXTUAL_HEADERS,
    deps = [
        "@emscripten_cache//:port_headers",
        "@libogg_wasm//:ogg",
        "@libsquish//:squish",
        "@libvorbis_wasm//:vorbis",
        "@libvorbis_wasm//:vorbisfile",
    ],
    alwayslink = True,
)

clang_tidy_wasm_check(
    name = "clang_tidy_wasm",
    srcs = [":saga_wasm_objects"],
    tags = ["manual"],
)

cc_binary(
    name = "saga",
    additional_linker_inputs = ["host-wasm-shell.html"],
    features = ["-output_format_js"],
    linkopts = [
        "--use-port=sdl3",
        "--oformat=html",
        "-sPROXY_TO_PTHREAD=1",
        "-sOFFSCREEN_FRAMEBUFFER=1",
        "-sFULL_ES2=1",
        "-sMAX_WEBGL_VERSION=2",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sINITIAL_MEMORY=268435456",
        "-sSTACK_SIZE=5242880",
        "-sASSERTIONS=1",
        "-sEXPORTED_RUNTIME_METHODS=FS,callMain",
        "--shell-file",
        "$(location host-wasm-shell.html)",
        "--emrun",
    ],
    linkstatic = True,
    deps = [":saga_wasm_objects"],
)

wasm_cc_binary(
    name = "saga_wasm",
    cc_target = ":saga",
    outputs = [
        "saga.html",
        "saga.js",
        "saga.wasm",
    ],
    threads = "emscripten",
)
